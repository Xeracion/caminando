# Copia este archivo a .env.local (en local) o pega estas 3 variables en
# Vercel → Project Settings → Environment Variables.
#
# Sin ellas, el sitio sigue funcionando con el contenido de ejemplo en
# lib/data/seed/ — nada se rompe, solo no verás el panel /studio conectado.

# Project ID: en sanity.io/manage, dentro de tu proyecto → Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# El dataset que crea Sanity por defecto se llama "production".
NEXT_PUBLIC_SANITY_DATASET=production

# Fecha de referencia del API de Sanity — no hace falta tocarla.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Necesaria solo para la "Vista previa" (editar viendo la página real) en
# /studio. Créala en sanity.io/manage → tu proyecto → API → Tokens → Add API
# token, con permiso "Viewer". Sin el prefijo NEXT_PUBLIC_: debe quedarse en
# el servidor, nunca llega al navegador.
SANITY_API_READ_TOKEN=
